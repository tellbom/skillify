# GitNexus v1.6.9 standalone deployment. Export these variables before running
# scripts/deployment/gitnexus-docker.sh; the script intentionally does not source
# this file as shell code.

GITNEXUS_SERVER_BASE_IMAGE=ghcr.io/abhigyanpatwari/gitnexus:1.6.9
GITNEXUS_SERVER_IMAGE=skillify/gitnexus:1.6.9-unlimited
GITNEXUS_WEB_IMAGE=ghcr.io/abhigyanpatwari/gitnexus-web:1.6.9
GITNEXUS_GATEWAY_IMAGE=nginx:1.27.5-alpine

GITNEXUS_BIND_HOST=0.0.0.0
GITNEXUS_SERVER_PORT=4747
GITNEXUS_WEB_PORT=4173
# Set this to the URL users enter in their browser. The gateway serves both the
# UI and /api on this origin, so remote browsers never receive 127.0.0.1:4747.
GITNEXUS_PUBLIC_URL=http://127.0.0.1:4173
GITNEXUS_BACKEND_URL=http://127.0.0.1:4173

GITNEXUS_STATE_ROOT=/srv/skillify/gitnexus
# 0 means Docker does not impose a resource cap. Set explicit values only when
# the target environment requires quotas.
GITNEXUS_SERVER_MEMORY=0
GITNEXUS_WEB_MEMORY=0
GITNEXUS_GATEWAY_MEMORY=0
GITNEXUS_SERVER_CPUS=0
GITNEXUS_WEB_CPUS=0
GITNEXUS_GATEWAY_CPUS=0
GITNEXUS_PIDS_LIMIT=0

# Optional. Leave empty to allow any HTTP(S) Git host reachable from the
# controlled intranet, or list exact hosts separated by commas.
GITNEXUS_ALLOWED_GIT_HOSTS=
GITNEXUS_GIT_TIMEOUT_SECONDS=300

# Offline-first: deploy checks for preloaded images and never contacts a public
# registry. Set to 0 only in an explicitly connected image-preparation environment.
GITNEXUS_SKIP_PULL=1
