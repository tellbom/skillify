# OpenAI-compatible intranet LLM endpoint. The portal runtime contacts no other
# public service. Do not place API keys in this file.
UA_LLM_BASE_URL=http://llm.internal/v1
UA_LLM_MODEL=your-model
UA_OUTPUT_LANGUAGE=zh
UA_LLM_CONCURRENCY=3
UA_LLM_TIMEOUT_SECONDS=120
UA_LLM_MAX_RETRIES=2
UA_LLM_JSON_MODE=1
UA_LLM_THINKING=disabled

# Analysis queue and upload limits.
UA_ANALYSIS_CONCURRENCY=1
UA_MAX_UPLOAD_BYTES=21474836480
UA_MAX_UNPACKED_BYTES=42949672960
UA_MAX_UPLOAD_FILES=200000

# Empty means any Git host reachable from the intranet is accepted.
UA_ALLOWED_GIT_HOSTS=
UA_GIT_TLS_VERIFY=1
UA_GIT_USERNAME=oauth2
